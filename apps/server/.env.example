PORT=8080
JWT_SECRET=troque-por-um-segredo-longo
# Habilita /admin/* (relatórios de uso para licenciantes).
ADMIN_TOKEN=
# Dias de teste do catálogo licenciado para contas novas.
TRIAL_DAYS=0
# Sem DATABASE_URL o servidor usa armazenamento em memória (apenas desenvolvimento).
DATABASE_URL=postgres://sonora:sonora@localhost:5432/sonora
# Importação de playlists do Spotify (crie um app em developer.spotify.com e cadastre o
# redirect URI sonora://spotify-callback). Só metadados: o áudio vem das fontes abaixo.
SPOTIFY_CLIENT_ID=
SPOTIFY_SYNC_INTERVAL_MS=300000
# Catálogo Creative Commons (https://devportal.jamendo.com) — streams em FLAC/MP3.
JAMENDO_CLIENT_ID=
# Biblioteca própria lossless via servidor compatível com Subsonic (Navidrome, Airsonic...).
SUBSONIC_URL=
SUBSONIC_USER=
SUBSONIC_PASSWORD=
