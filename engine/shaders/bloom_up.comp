#version 460
// Bloom físico, subida: filtro tenda 3x3 do nível menor somado ao nível atual.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D lower;
layout(set = 1, binding = 1, rgba16f) uniform image2D dst;
layout(push_constant) uniform Push { vec2 lowerTexel; float radius; float pad; } pc;

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(dst);
  if (any(greaterThanEqual(id, size))) return;
  vec2 uv = (vec2(id) + 0.5) / vec2(size);
  vec2 t = pc.lowerTexel * pc.radius;
  vec3 sum = textureLod(lower, uv, 0.0).rgb * 4.0;
  sum += (textureLod(lower, uv + vec2(-t.x, 0), 0.0).rgb + textureLod(lower, uv + vec2(t.x, 0), 0.0).rgb +
          textureLod(lower, uv + vec2(0, -t.y), 0.0).rgb + textureLod(lower, uv + vec2(0, t.y), 0.0).rgb) * 2.0;
  sum += textureLod(lower, uv - t, 0.0).rgb + textureLod(lower, uv + t, 0.0).rgb +
         textureLod(lower, uv + vec2(-t.x, t.y), 0.0).rgb + textureLod(lower, uv + vec2(t.x, -t.y), 0.0).rgb;
  imageStore(dst, id, vec4(imageLoad(dst, id).rgb + sum / 16.0, 1.0));
}
