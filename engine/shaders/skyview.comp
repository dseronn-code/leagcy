#version 460
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D skyViewOut;

void main() {
  ivec2 size = imageSize(skyViewOut);
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(id, size))) return;
  vec3 dir = lutDirection((vec2(id) + 0.5) / vec2(size));
  vec3 L = integrateSky(planetPos(frame.cameraPos.xyz), dir, frame.sunDir.xyz, frame.sunDir.w);
  imageStore(skyViewOut, id, vec4(L, 1.0));
}
