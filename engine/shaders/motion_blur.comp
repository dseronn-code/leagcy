#version 460
// Motion blur por pixel ao longo do vetor de movimento (obturador de 180° por padrão).
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D colorIn;
layout(set = 1, binding = 1) uniform sampler2D gMotion;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D colorOut;
layout(push_constant) uniform Push { float shutter; float maxPixels; float pad0; float pad1; } pc;

const int SAMPLES = 12;

vec2 motionPixels(vec2 uv) {
  vec2 m = texelFetch(gMotion, ivec2(clamp(uv, 0.0, 1.0) * frame.renderSize.xy), 0).xy * frame.outputSize.xy * pc.shutter;
  float len = length(m);
  return len > pc.maxPixels ? m * (pc.maxPixels / len) : m;
}

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(id, ivec2(frame.outputSize.xy)))) return;
  vec2 uv = (vec2(id) + 0.5) * frame.outputSize.zw;
  vec3 center = texelFetch(colorIn, id, 0).rgb;
  vec2 v = motionPixels(uv);
  float speed = length(v);
  if (speed < 0.5) { imageStore(colorOut, id, vec4(center, 1.0)); return; }

  vec3 sum = center;
  float wsum = 1.0;
  float jitter = fract(52.9829189 * fract(dot(vec2(id), vec2(0.06711056, 0.00583715))));  // ruído IGN
  for (int i = 0; i < SAMPLES; ++i) {
    float t = (float(i) + jitter) / float(SAMPLES) - 0.5;
    vec2 suv = uv + v * t * frame.outputSize.zw;
    // Só borra com amostras que também se movem o bastante para cobrir este pixel.
    float w = clamp(length(motionPixels(suv)) / max(abs(t) * speed * 2.0, 1e-3), 0.0, 1.0);
    sum += textureLod(colorIn, suv, 0.0).rgb * w;
    wsum += w;
  }
  imageStore(colorOut, id, vec4(sum / wsum, 1.0));
}
