#version 460
// Bloom físico, descida: filtro de 13 amostras (Jimenez, COD: Advanced Warfare).
// O primeiro nível usa média de Karis para não deixar pontos brilhantes "piscarem".
#extension GL_GOOGLE_include_directive : require
#include "brdf.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D src;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform Push { vec2 srcTexel; uint karis; float pad; } pc;

vec3 s(vec2 uv) { return textureLod(src, uv, 0.0).rgb; }
float karisWeight(vec3 c) { return 1.0 / (1.0 + luminance(c)); }

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(dst);
  if (any(greaterThanEqual(id, size))) return;
  vec2 uv = (vec2(id) + 0.5) / vec2(size);
  vec2 t = pc.srcTexel;
  vec3 a = s(uv + t * vec2(-2, -2)), b = s(uv + t * vec2(0, -2)), c = s(uv + t * vec2(2, -2));
  vec3 d = s(uv + t * vec2(-2, 0)), e = s(uv), f = s(uv + t * vec2(2, 0));
  vec3 g = s(uv + t * vec2(-2, 2)), h = s(uv + t * vec2(0, 2)), i = s(uv + t * vec2(2, 2));
  vec3 j = s(uv + t * vec2(-1, -1)), k = s(uv + t * vec2(1, -1)), l = s(uv + t * vec2(-1, 1)), m = s(uv + t * vec2(1, 1));
  vec3 g0 = (a + b + d + e) * 0.25, g1 = (b + c + e + f) * 0.25, g2 = (d + e + g + h) * 0.25, g3 = (e + f + h + i) * 0.25;
  vec3 g4 = (j + k + l + m) * 0.25;
  vec3 result;
  if (pc.karis != 0u) {
    float w0 = karisWeight(g0), w1 = karisWeight(g1), w2 = karisWeight(g2), w3 = karisWeight(g3), w4 = karisWeight(g4);
    result = (g0 * w0 * 0.125 + g1 * w1 * 0.125 + g2 * w2 * 0.125 + g3 * w3 * 0.125 + g4 * w4 * 0.5) /
             (w0 * 0.125 + w1 * 0.125 + w2 * 0.125 + w3 * 0.125 + w4 * 0.5);
  } else {
    result = (g0 + g1 + g2 + g3) * 0.125 + g4 * 0.5;
  }
  imageStore(dst, id, vec4(max(result, vec3(0.0)), 1.0));
}
