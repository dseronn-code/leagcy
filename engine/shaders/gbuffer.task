#version 460
// Task shader do G-buffer com meshlets: cada grupo testa 32 meshlets de uma instância visível (a lista compactada do
// culling por objeto) e lança um grupo do mesh shader por meshlet que sobrevive.
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
#include "meshlet.glsl"

layout(local_size_x = 32) in;
taskPayloadSharedEXT MeshletTask task;
shared uint keepMask;

void main() {
  DrawCommand cmd = DrawCommands(pc.commands).c[pc.batch];
  uint groupsPerInstance = (pc.meshletCount + MESHLET_GROUP - 1u) / MESHLET_GROUP;
  uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
  uint slot = group / groupsPerInstance, lane = gl_LocalInvocationIndex;
  uint m = (group % groupsPerInstance) * MESHLET_GROUP + lane;
  if (lane == 0u) keepMask = 0u;
  barrier();
  bool live = slot < cmd.instanceCount;
  uint entry = live ? DrawList(pc.drawList).objects[cmd.firstInstance + slot] : 0u;
  mat4 model = objects[entry & 0xFFFFFFu].model;
  // O bloco inteiro antes (o mesmo resultado nas 32 invocações): fora do corte ou da tela, nenhum meshlet é testado.
  bool blockLive = live && blockMayDraw(group % groupsPerInstance, model);
  Meshlet ml;
  bool keep = blockLive && m < pc.meshletCount && meshletInLodCut(m, model);
  if (keep) {
    ml = MeshletList(pc.meshlets).m[m];
    keep = meshletVisible(ml, model) && meshletPassesOcclusion(ml, entry & 0xFFFFFFu);
  }
  // Rasterização por software (geometria virtualizada): pedaço pequeno na tela (triângulos de ~1 pixel, caros para o
  // rasterizador fixo) vai para a lista de sw_raster.comp em vez do mesh shader. Materiais com recorte, mistura,
  // cabelo, água ou vento ficam no caminho normal (a passada por software guarda uma camada só).
  if (keep && pc.swList != 0ul && pc.lodBase != 0u) {
    uint object = entry & 0xFFFFFFu;
    float scale = max(length(model[0].xyz), max(length(model[1].xyz), length(model[2].xyz)));
    float r = ml.radius * scale, d = length((model * vec4(ml.center, 1.0)).xyz - frame.cameraPos.xyz);
    float diameter = 2.0 * r / max(d, 0.01) * abs(frame.proj[1][1]) * 0.5 * frame.renderSize.y;
    uint mflags = materials[instances[object].material].flags;
    const uint special = MATERIAL_ALPHA_MASK | MATERIAL_BLEND | MATERIAL_HAIR | MATERIAL_WATER | MATERIAL_FOLIAGE |
                         MATERIAL_RIVER;
    if ((mflags & special) == 0u && diameter < pc.swPixels && d > r + 0.1) {
      SwList list = SwList(pc.swList);
      uint i = atomicAdd(list.count, 1u);
      if (i < pc.swMax) {
        list.entries[i] = uvec2(object, m);
        keep = false;
      }
    }
  }
  if (keep) atomicOr(keepMask, 1u << lane);
  barrier();
  // Compactação na ordem original (posição = quantos antes dele sobreviveram).
  uint mask = keepMask;
  if (keep) task.meshlets[bitCount(mask & ((1u << lane) - 1u))] = m;
  if (lane == 0u) task.entry = entry;
  EmitMeshTasksEXT(uint(bitCount(mask)), 1u, 1u);
}
