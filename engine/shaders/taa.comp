#version 460
// TAA com upscaling temporal (TAAU): roda na resolução de SAÍDA. Cada frame a cena é
// renderizada em resolução menor com jitter subpixel diferente; o histórico reprojetado
// acumula essas amostras e reconstrói detalhe acima da resolução interna.
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"
#include "brdf.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D sceneColor;   // resolução interna (sampler linear)
layout(set = 1, binding = 1) uniform sampler2D gDepth;       // resolução interna
layout(set = 1, binding = 2) uniform sampler2D gMotion;      // resolução interna
layout(set = 1, binding = 3) uniform sampler2D history;      // saída do frame anterior (sampler linear)
layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D outColor;
layout(set = 1, binding = 5) uniform sampler2D reactiveMask;  // partículas neste quadro (resolução interna)

vec3 rgbToYCoCg(vec3 c) {
  return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)), dot(c, vec3(-0.25, 0.5, -0.25)));
}
vec3 yCoCgToRgb(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

// Catmull-Rom com 5 leituras bilineares (Jimenez): histórico nítido, sem borrar a cada frame.
vec3 sampleHistory(vec2 uv) {
  vec2 size = frame.outputSize.xy;
  vec2 pos = uv * size;
  vec2 tc = floor(pos - 0.5) + 0.5;
  vec2 f = pos - tc;
  vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
  vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
  vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
  vec2 w3 = f * f * (-0.5 + 0.5 * f);
  vec2 w12 = w1 + w2;
  vec2 tc0 = (tc - 1.0) / size, tc3 = (tc + 2.0) / size, tc12 = (tc + w2 / w12) / size;
  vec3 r = textureLod(history, vec2(tc12.x, tc0.y), 0.0).rgb * (w12.x * w0.y) +
           textureLod(history, vec2(tc0.x, tc12.y), 0.0).rgb * (w0.x * w12.y) +
           textureLod(history, vec2(tc12.x, tc12.y), 0.0).rgb * (w12.x * w12.y) +
           textureLod(history, vec2(tc3.x, tc12.y), 0.0).rgb * (w3.x * w12.y) +
           textureLod(history, vec2(tc12.x, tc3.y), 0.0).rgb * (w12.x * w3.y);
  float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
  return max(r / wsum, vec3(0.0));
}

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(id, ivec2(frame.outputSize.xy)))) return;
  vec2 uv = (vec2(id) + 0.5) * frame.outputSize.zw;

  // Posição do centro deste pixel de saída no frame interno, já sem o jitter (o pixel interno em u mostra o
  // ponto que, sem jitter, estaria em u - jitter).
  vec2 renderUv = uv + frame.jitter.xy;
  vec2 renderPos = renderUv * frame.renderSize.xy - 0.5;  // coordenada contínua: o pixel q tem centro em q
  ivec2 rp = ivec2(floor(renderPos + 0.5));
  ivec2 maxP = ivec2(frame.renderSize.xy) - 1;

  // Quanto a vizinhança se mexe (em pixels de saída): parada, o histórico já convergido é a melhor estimativa e as
  // defesas contra rastro e cintilação (corte do histórico e pesos de Karis) só atrapalham — com a imagem ainda com
  // ruído do path tracing (poucas amostras muito claras) as duas puxavam a média para baixo. Medido no Bistro
  // contra a referência por path tracing (240x136, SVGF): -23,2% com elas sempre ligadas; sem elas, +2,9% sem
  // denoiser. Em movimento elas voltam por inteiro.
  vec3 rgbs[9];
  float maxMove = 0.0, reactive = 0.0;
  for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x) {
      ivec2 q = clamp(rp + ivec2(x, y), ivec2(0), maxP);
      rgbs[(y + 1) * 3 + x + 1] = texelFetch(sceneColor, q, 0).rgb;
      maxMove = max(maxMove, length(texelFetch(gMotion, q, 0).xy * frame.outputSize.xy));
      reactive = max(reactive, texelFetch(reactiveMask, q, 0).r);
    }
  // Partícula no pixel (máscara reativa): mexe sem vetor de movimento; vale como "em movimento" (corte firme).
  reactive = clamp(reactive * 50.0, 0.0, 1.0);  // qualquer partícula no pixel conta (até as pontas fracas da chama)
  float moving = perfSkip(PERF_DIAG_TAA_OLD) ? 1.0 : max(smoothstep(0.05, 0.5, maxMove), reactive);

  // Reconstrução da amostra atual por kernel (Karis, "High Quality Temporal Supersampling", 2014): os 3x3
  // pixels internos vizinhos pesados por uma gaussiana da distância até o centro do pixel
  // de saída — no lugar da leitura bilinear, que borrava a imagem a cada frame. Em movimento, peso extra 1/(1+L)
  // para um ponto muito brilhante não dominar (vagalumes). A mesma vizinhança dá os limites do histórico e o pixel
  // mais próximo (vetor de movimento dilatado).
  vec3 m1 = vec3(0.0), m2 = vec3(0.0), sum = vec3(0.0);
  float wsum = 0.0, wmax = 0.0;
  float closest = -1.0;
  ivec2 closestP = clamp(rp, ivec2(0), maxP);
  for (int y = -1; y <= 1; ++y) {
    for (int x = -1; x <= 1; ++x) {
      ivec2 q = clamp(rp + ivec2(x, y), ivec2(0), maxP);
      vec3 rgb = rgbs[(y + 1) * 3 + x + 1];
      vec3 c = rgbToYCoCg(rgb);
      m1 += c;
      m2 += c * c;
      vec2 dq = vec2(rp + ivec2(x, y)) - renderPos;  // em pixels internos
      // Gaussiana estreita (σ = 0,25 px interno): medido em tools/taa.py, a largura do Blackman-Harris clássico
      // (exp(-2,29 d²)) amolecia a imagem; k = 8 dá a maior nitidez com o menor erro contra a referência 4x.
      float w = exp(-8.0 * dot(dq, dq));
      wmax = max(wmax, w);
      w /= 1.0 + moving * luminance(rgb);
      sum += rgb * w;
      wsum += w;
      float d = texelFetch(gDepth, q, 0).r;
      if (d > closest) { closest = d; closestP = q; }  // reverse-Z: maior = mais perto
    }
  }
  vec3 current = sum / max(wsum, 1e-8);
  vec3 mean = m1 / 9.0;
  vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, 0.0));

  vec2 prevUv = uv - texelFetch(gMotion, closestP, 0).xy;
  vec3 result = current;
  float yCur = rgbToYCoCg(current).x;
  float m2Out = yCur * yCur;  // 2º momento do brilho (Y), guardado no alfa do histórico
  if (historyValid() && all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThanEqual(prevUv, vec2(1.0)))) {
    // Clipping de variância em YCoCg: descarta histórico que não "cabe" na vizinhança (anti-rastro).
    float es = historyExposureScale();
    vec3 h = rgbToYCoCg(sampleHistory(prevUv) * es);
    float m2h = max(textureLod(history, prevUv, 0.0).a, 0.0) * es * es;
    // Caixa: σ da vizinhança 3x3 deste quadro e, com a imagem parada, também o σ do próprio pixel no tempo (2º
    // momento guardado no histórico). O ruído do path tracing é assimétrico (poucas amostras muito claras): a
    // vizinhança costuma sair toda escura com σ quase zero e cortava o histórico já convergido para baixo (o Bistro
    // ficava ~20% mais escuro na escala de teste). Com o σ temporal, ruído não corta; uma mudança de verdade sem
    // vetor de movimento (partícula que passou, sombra que andou, luz que apagou) sai de uma variação pequena e corta.
    float sigmaT = sqrt(max(m2h - h.x * h.x, 0.0));
    vec3 sig = mix(max(sigma, vec3(sigmaT, 0.5 * sigmaT, 0.5 * sigmaT)), sigma, moving);
    vec3 lo = mean - 1.25 * sig, hi = mean + 1.25 * sig;
    vec3 center = 0.5 * (lo + hi), ext = max(0.5 * (hi - lo), vec3(1e-4));
    vec3 rel = (h - center) / ext;
    float maxRel = max(abs(rel.x), max(abs(rel.y), abs(rel.z)));
    if (maxRel > 1.0) {
      float yBefore = h.x;
      h = center + (h - center) / maxRel;
      m2h += h.x * h.x - yBefore * yBefore;  // o 2º momento acompanha a média cortada (a variância fica)
    }
    vec3 hist = yCoCgToRgb(h);

    // Upscaling: confia mais no frame atual quando alguma amostra caiu perto do centro do pixel de saída.
    float alpha = mix(0.04, 0.15, wmax);
    // Pesos por luminância (Karis) em movimento: evita que pontos muito brilhantes cintilem. Parada, puxariam a
    // média para baixo (mesmo motivo do corte).
    float wc = alpha / (1.0 + moving * luminance(current));
    float wh = (1.0 - alpha) / (1.0 + moving * luminance(hist));
    result = (current * wc + hist * wh) / (wc + wh);
    m2Out = mix(m2h, yCur * yCur, alpha);
    // Onde há partícula, a variação no tempo não é ruído: zera (quando ela sair dali, o rastro é cortado).
    float yRes = rgbToYCoCg(result).x;
    m2Out = mix(m2Out, yRes * yRes, reactive);  // variância zero em volta do que foi gravado
  }
  if (any(isnan(result)) || any(isinf(result))) result = vec3(0.0);
  if (isnan(m2Out) || isinf(m2Out)) m2Out = 0.0;
  imageStore(outColor, id, vec4(result, m2Out));
}
