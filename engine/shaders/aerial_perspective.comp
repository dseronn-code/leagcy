#version 460
// Perspectiva aérea (Hillaire 2020): volume 32x32x32 alinhado ao frustum com o in-scattering e a
// transmitância da atmosfera entre a câmera e cada fatia de profundidade (até 32 km, distribuição
// quadrática para ter detalhe perto). Montanhas ao longe ficam azuladas e com contraste reduzido.
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D apOut;

const float AP_MAX_DISTANCE_KM = 32.0;

void main() {
  ivec3 size = imageSize(apOut);
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(id, size.xy))) return;
  vec2 uv = (vec2(id) + 0.5) / vec2(size.xy);
  vec3 rd = viewDirFromUv(uv);
  vec3 ro = planetPos(frame.cameraPos.xyz);
  vec3 sunDir = frame.sunDir.xyz;
  float sunE = frame.sunDir.w;
  if (frame.environment.x > 0.0) sunE = 0.0;  // fornalha branca: sem atmosfera

  vec3 L = vec3(0.0), T = vec3(1.0);
  float tPrev = 0.0;
  float mu = dot(rd, sunDir);
  float pR = rayleighPhase(mu), pM = miePhase(mu);
  for (int s = 0; s < size.z; ++s) {
    float w = (float(s) + 1.0) / float(size.z);
    float tSlice = AP_MAX_DISTANCE_KM * w * w;
    // Dois subpassos por fatia.
    for (int k = 0; k < 2; ++k) {
      float t = mix(tPrev, tSlice, (float(k) + 1.0) * 0.5);
      float t0 = k == 0 ? tPrev : mix(tPrev, tSlice, 0.5);
      float dt = t - t0;
      vec3 p = ro + rd * (t0 + 0.5 * dt);
      vec3 sR, ext; float sM;
      sampleMedium(max(length(p) - R_GROUND, 0.0), sR, sM, ext);
      vec3 S = sunE * (transmittanceToSun(p, sunDir) * (sR * pR + sM * pM) + multiScatter(p, sunDir) * (sR + sM));
      vec3 sampleT = exp(-ext * dt);
      L += T * (S - S * sampleT) / max(ext, vec3(1e-7));
      T *= sampleT;
    }
    tPrev = tSlice;
    imageStore(apOut, ivec3(id, s), vec4(clampHalf(L * preExposure()), dot(T, vec3(1.0 / 3.0))));
  }
}
