#version 460
// Referência das nuvens (--clouds-reference): Monte Carlo volumétrico sem aproximação, para medir clouds.glsl. Mesma
// densidade (com detalhe em todo ponto), mesmo albedo, mesma fase de duas lobas, mesmo sol (com a transmitância da
// atmosfera) e o mesmo céu: delta tracking para as colisões reais, ratio tracking para a sombra do sol em cada
// espalhamento, nova direção sorteada pela fase, e ao sair da camada o caminho vê o céu naquela direção (chão = preto).
// Espalhamento múltiplo de verdade (até a luz escapar), roleta russa sem viés. Acumula com a cena parada.
#extension GL_GOOGLE_include_directive : require
#include "clouds.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D cloudsOut;
layout(set = 1, binding = 1) uniform sampler2D cloudsPrev;
layout(set = 1, binding = 2) uniform sampler2D clearSky;
layout(push_constant) uniform Push { uint frames; } pc;

uint rngState;
float rnd() {
  rngState = rngState * 747796405u + 2891336453u;
  uint w = ((rngState >> ((rngState >> 28u) + 4u)) ^ rngState) * 277803737u;
  return float((w >> 22u) ^ w) * (1.0 / 4294967296.0);
}

const float SIGMA_MAX = CLOUD_EXTINCTION;  // densidade ≤ 1
float sigmaAt(vec3 p) { return cloudDensity(p, cloudHeightFraction(p), true) * CLOUD_EXTINCTION; }

bool deltaTrack(vec3 o, vec3 d, float tmax, out float t) {
  t = 0.0;
  for (int i = 0; i < 100000; ++i) {
    t -= log(1.0 - rnd()) / SIGMA_MAX;
    if (t >= tmax) return false;
    if (rnd() * SIGMA_MAX < sigmaAt(o + d * t)) return true;
  }
  return false;
}

float ratioTrack(vec3 o, vec3 d, float tmax) {
  float T = 1.0, t = 0.0;
  for (int i = 0; i < 100000; ++i) {
    t -= log(1.0 - rnd()) / SIGMA_MAX;
    if (t >= tmax) break;
    T *= 1.0 - sigmaAt(o + d * t) / SIGMA_MAX;
    if (T < 1e-5) return 0.0;
  }
  return T;
}

// Direção nova com densidade cloudPhase(dot(d, d'), 1): escolhe a loba pelo peso e sorteia Henyey-Greenstein.
vec3 samplePhase(vec3 d) {
  float g = rnd() < 0.75 ? 0.8 : -0.25, u = rnd();
  float s = (1.0 - g * g) / (1.0 - g + 2.0 * g * u);
  float c = clamp((1.0 + g * g - s * s) / (2.0 * g), -1.0, 1.0);
  float sn = sqrt(max(1.0 - c * c, 0.0)), ph = 2.0 * PI * rnd();
  vec3 a = abs(d.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
  vec3 x = normalize(cross(a, d)), y = cross(d, x);
  return normalize(d * c + (x * cos(ph) + y * sin(ph)) * sn);
}

// Segmento dentro da camada a partir de p (e se o resto do raio bate no chão).
bool layer(vec3 p, vec3 d, out float t0, out float t1, out bool ground) {
  ground = false;
  float g0, g1;
  if (raySphere(p, d, R_GROUND, g0, g1) && g0 > 0.0) ground = true;
  return cloudSegment(p, d, t0, t1);
}

void main() {
  ivec2 size = imageSize(cloudsOut), id = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(id, size))) return;
  rngState = pcg3d(uvec3(uvec2(id), pc.frames * 7919u + 13u)).x;
  vec2 uv = (vec2(id) + vec2(rnd(), rnd())) / vec2(size);
  vec3 dir = viewDirFromUv(uv), o = cloudPlanetPos(frame.cameraPos.xyz), L = frame.sunDir.xyz;
  vec3 S = vec3(0.0);
  float T = 1.0, t0, t1, haze = 1.0;
  bool ground;
  if (cloudCoverage() > 0.0 && cloudSegment(o, dir, t0, t1) && t0 <= 120.0) {
    t1 = min(t1, t0 + 30.0);  // o mesmo domínio de clouds.glsl
    haze = exp(-t0 / 60.0);
    float t;
    if (deltaTrack(o + dir * t0, dir, t1 - t0, t)) {
      T = 0.0;
      vec3 p = o + dir * (t0 + t), d = dir;
      float w = 1.0;
      for (int ev = 0; ev < 4096; ++ev) {
        w *= CLOUD_ALBEDO;
        if (frame.sunDir.w > 0.0) {  // sol neste espalhamento
          float s0, s1;
          bool gnd;
          float Ts = layer(p, L, s0, s1, gnd) ? ratioTrack(p + L * s0, L, s1 - s0) : 1.0;
          vec3 sunE = frame.sunDir.w * preExposure() * transmittanceToSun(p, L);
          S += w * sunE * cloudPhase(dot(d, L), 1.0) * Ts;
        }
        d = samplePhase(d);
        float a0, a1;
        bool gnd;
        if (!layer(p, d, a0, a1, gnd) || !deltaTrack(p + d * a0, d, a1 - a0, t)) {
          if (!gnd) S += w * textureLod(clearSky, skyLutUv(d), 0.0).rgb;  // escapou: o céu dessa direção
          break;
        }
        p += d * (a0 + t);
        if (ev > 8) {  // roleta russa (sem viés)
          const float q = 0.98;
          if (rnd() > q) break;
          w /= q;
        }
      }
    }
  }
  vec4 cur = vec4(S * haze, mix(1.0, T, haze));
  if (pc.frames > 0u) cur = mix(texelFetch(cloudsPrev, id, 0), cur, 1.0 / float(pc.frames + 1u));
  imageStore(cloudsOut, id, vec4(clampHalf(cur.rgb), clamp(cur.a, 0.0, 1.0)));
}
