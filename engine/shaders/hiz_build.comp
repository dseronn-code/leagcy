#version 460
// Pirâmide de profundidade (HiZ) para a oclusão: cada texel do nível n guarda a profundidade MAIS DISTANTE dos 2x2
// (ou 3x3 nas bordas ímpares) do nível n − 1. Reverse-Z: mais distante = menor valor (min).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D srcLevel;  // nível anterior (ou a profundidade da cena no nível 0)
layout(set = 1, binding = 1, r32f) uniform writeonly image2D dstLevel;
layout(push_constant) uniform Push { uint fromDepth; } pc;

void main() {
  ivec2 dst = ivec2(gl_GlobalInvocationID.xy), size = imageSize(dstLevel);
  if (any(greaterThanEqual(dst, size))) return;
  ivec2 srcSize = textureSize(srcLevel, 0);
  if (pc.fromDepth != 0u) {  // nível 0: a própria profundidade (mesma resolução)
    imageStore(dstLevel, dst, vec4(texelFetch(srcLevel, dst, 0).r));
    return;
  }
  ivec2 base = dst * 2;
  float d = 1.0;
  // Nível de cima com tamanho ímpar: a última linha/coluna cobre 3 texels de baixo.
  int ex = (dst.x == size.x - 1 && (srcSize.x & 1) != 0) ? 3 : 2, ey = (dst.y == size.y - 1 && (srcSize.y & 1) != 0) ? 3 : 2;
  for (int y = 0; y < ey; ++y)
    for (int x = 0; x < ex; ++x) d = min(d, texelFetch(srcLevel, min(base + ivec2(x, y), srcSize - 1), 0).r);
  imageStore(dstLevel, dst, vec4(d));
}
