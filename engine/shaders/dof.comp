#version 460
// Profundidade de campo com autofoco (lente fina, "scatter-as-gather"): cada pixel coleta
// vizinhos cujo círculo de confusão alcança o pixel — sem vazar fundo sobre o primeiro plano.
#extension GL_GOOGLE_include_directive : require
#include "frame.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0) uniform sampler2D colorIn;
layout(set = 1, binding = 1) uniform sampler2D gDepth;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D colorOut;
layout(push_constant) uniform Push { float focusDistance; float aperture; float maxCoc; float pad; } pc;

const float GOLDEN_ANGLE = 2.39996323;

float depthAt(vec2 uv) {
  return linearDepth(texelFetch(gDepth, ivec2(clamp(uv, 0.0, 1.0) * frame.renderSize.xy), 0).r);
}
// Círculo de confusão em pixels de saída (0 no plano de foco).
float coc(float z, float focus) { return min(pc.aperture * abs(1.0 - focus / z), pc.maxCoc); }

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(id, ivec2(frame.outputSize.xy)))) return;
  vec2 uv = (vec2(id) + 0.5) * frame.outputSize.zw;

  // Autofoco: o mais próximo de 5 pontos ao redor do centro da tela.
  float focus = pc.focusDistance;
  if (focus <= 0.0) {
    focus = depthAt(vec2(0.5));
    for (int i = 0; i < 4; ++i) focus = min(focus, depthAt(vec2(0.5) + 0.02 * vec2((i & 1) != 0 ? 1.0 : -1.0, (i & 2) != 0 ? 1.0 : -1.0)));
  }
  float zc = depthAt(uv);
  float cc = coc(zc, focus);
  vec3 sum = texelFetch(colorIn, id, 0).rgb;
  float wsum = 1.0;
  int samples = int(frame.quality0.w);
  for (int i = 0; i < samples; ++i) {
    float r = sqrt((float(i) + 0.5) / float(samples)) * pc.maxCoc;
    float a = float(i) * GOLDEN_ANGLE;
    vec2 suv = uv + vec2(cos(a), sin(a)) * r * frame.outputSize.zw;
    float zs = depthAt(suv);
    float cs = coc(zs, focus);
    // Amostra conta se seu borrão chega até aqui; fundo só conta se o próprio pixel está borrado.
    float reach = smoothstep(r - 1.0, r + 1.0, cs);
    float w = zs <= zc * 1.02 ? reach : reach * smoothstep(r - 1.0, r + 1.0, cc);
    sum += textureLod(colorIn, suv, 0.0).rgb * w;
    wsum += w;
  }
  imageStore(colorOut, id, vec4(sum / wsum, 1.0));
}
